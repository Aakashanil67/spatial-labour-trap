# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Claude Code / agent tooling -- not portfolio content, see DECISIONS.md
CLAUDE.md
.claude/state.md
.claude/session-log.md

# Raw survey microdata -- DataFirst licence forbids redistribution. Never lift this rule;
# see data/README.md and paper/notes/prompt-0.2-licence-check.md.
data/raw/
*.dta
*.sav
*.por
*.zip

# Large / regenerable artefacts -- see I4 in DECISIONS.md for exactly what stays committed
results/cache/
results/figures/
notebooks/moments/*.html

# results/published/ is the one results/ subtree meant to be committed (Task 7 of the
# verification remediation plan): SQ1's per-seed table and summary, and any other small,
# deliberately-selected aggregate output. Ignore everything in it by default, then allowlist
# only the file types that belong there, so a stray cache dump or exploratory figure written
# into the same directory doesn't get committed by a bare `git add`.
results/published/*
!results/published/*.csv
!results/published/*.json

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local git worktrees used for isolated remediation work
.worktrees/
